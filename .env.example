# Copy to .env and fill in. Never commit the real .env.

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/connectflow"

# Auth (better-auth)
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Inngest (leave keys empty for the local dev server)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Random string (32+ chars). Used to sign API keys and webhook tokens.
# Changing it invalidates all issued API keys and webhook URLs.
API_SECRET_KEY="generate-with: openssl rand -hex 32"

# Polar billing (sandbox)
POLAR_ACCESS_TOKEN=""
POLAR_SUCCESS_URL="http://localhost:3000/workflows"

# Public base URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional
SENTRY_DSN=""
NGROK_URL=""
